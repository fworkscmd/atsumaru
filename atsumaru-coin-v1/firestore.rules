rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 卓（テーブル）1つ = ドキュメント1つ。卓コードは英数字4〜8文字
    match /tables/{tableId} {
      // 読むのは、匿名ログインした人なら誰でも（卓コードを知っている人）
      allow read: if request.auth != null;

      // 新しい卓を開けるのは、自分を部屋主にして1人目として入るときだけ
      allow create: if request.auth != null
        && tableId.matches('^[A-Z0-9]{4,8}$')
        && request.resource.data.host == request.auth.uid
        && request.resource.data.players == [request.auth.uid];

      allow update: if request.auth != null && (
        // 卓のメンバーはゲームを進められる
        request.auth.uid in resource.data.players
        // メンバーでない人は、受付中に「参加希望」を出すことだけできる
        || (resource.data.status == 'lobby'
            && request.auth.uid in request.resource.data.get('requests', [])
            && request.resource.data.players == resource.data.players
            && request.resource.data.host == resource.data.host)
        // 終わった卓は、誰でも新しく集合し直せる
        || resource.data.status == 'over'
      );

      allow delete: if false;
    }
  }
}
